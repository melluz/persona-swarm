    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.19.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
